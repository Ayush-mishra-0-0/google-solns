# Store in your shell or a local, untracked .env file. Never commit values.
GEMINI_API_KEY=
YOUTUBE_API_KEY=
# Only used for the FIRST local OAuth consent flow.
YOUTUBE_CLIENT_SECRETS_FILE=./client_secret.json
YOUTUBE_TOKEN_FILE=./youtube_token.json
# For unattended GitHub Actions, store BASE64 of the token JSON as an encrypted secret.
YOUTUBE_TOKEN_JSON_BASE64=
